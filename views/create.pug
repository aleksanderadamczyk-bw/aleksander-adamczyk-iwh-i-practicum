doctype html
html(lang="en")
    head
        title Create processor
        link(rel="stylesheet", href="/css/style.css")
    body
        .form-wrapper
            h1 Create a new processor
            form(method="POST" action="/create-cobj")
                label(for="name") Name
                input(type="text" name="name" id="name" required)
                label(for="name") Processor Model
                input(type="text" name="newValProcModel" id="newValProcModel" required)
                label(for="base_clock_in_ghz") Base Clock (GHz)
                input(type="number" step="0.01" name="base_clock_in_ghz" id="base_clock_in_ghz")
                label(for="boost_clock_in_ghz") Boost Clock (GHz)
                input(type="number" step="0.01" name="boost_clock_in_ghz" id="boost_clock_in_ghz")
                label(for="core_count") Core count
                input(type="number" name="core_count" id="core_count")
                input(type="submit" value="Create")

        a(href="/") Back to processors
